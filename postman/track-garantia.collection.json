    {
      "name": "2 · Acceso jefe (login + OTP)",
      "item": [
        {
          "name": "Login jefe@prueba.local",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.request.body.raw = JSON.stringify({ email: \"jefe@prueba.local\", password: pm.variables.get(\"password\") });"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
