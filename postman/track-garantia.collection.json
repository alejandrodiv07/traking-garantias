        {
          "name": "Abrir orden",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"clave_envio\", pm.variables.replaceIn(\"{{$guid}}\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));",
                  "const o = pm.response.json()[0];",
                  "pm.test(\"numero OS-AAAA-NNNN\", () => pm.expect(o.numero_orden).to.match(/^OS-\\d{4}-\\d{4,}$/));",
                  "pm.test(\"cobertura EN_GARANTIA\", () => pm.expect(o.cobertura).to.eql(\"EN_GARANTIA\"));",
                  "pm.collectionVariables.set(\"orden_id\", o.orden_id);",
                  "pm.collectionVariables.set(\"numero_orden\", o.numero_orden);"
                ]
