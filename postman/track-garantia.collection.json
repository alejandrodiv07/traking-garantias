              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"p_serial\": \"NO-EXISTE-999\"\n}"
            }
          }
        },
        {
          "name": "Tablero de garantías lista el equipo",
          "event": [
            {
