{
  "info": {
    "name": "Track Garantía — Ventas, roles y taller (Supabase local)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Importación de facturas de Ventas con confirmación automática, permisos por rol y reglas del taller. Requiere el entorno local y los usuarios tecnico@, jefe@ y recepcion@prueba.local."
  },
  "item": [
    {
      "name": "0 · Acceso técnico",
      "item": [
        {
          "name": "Login tecnico@prueba.local",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.request.body.raw = JSON.stringify({ email: \"tecnico@prueba.local\", password: pm.variables.get(\"password\") });"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"login 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set(\"tokT\", j.access_token);",
                  "pm.collectionVariables.set(\"uidT\", j.user.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{anon_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/auth/v1/token?grant_type=password",
              "host": [
                "{{base}}/auth/v1/token?grant_type=password"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"tecnico@prueba.local\",\n  \"password\": \"{{password}}\"\n}"
            }
          }
        },
        {
          "name": "Emitir OTP (T)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"OTP emitido\", () => pm.expect(pm.response.code).to.be.oneOf([200, 204]));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{anon_key}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokT}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/rest/v1/rpc/generate_mfa_code",
              "host": [
                "{{base}}/rest/v1/rpc/generate_mfa_code"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          }
        },
        {
          "name": "Leer OTP (T)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"hay código vivo\", () => pm.expect(pm.response.json().length).to.eql(1));",
                  "pm.collectionVariables.set(\"otpT\", pm.response.json()[0].code);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "apikey",
                "value": "{{service_key}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{service_key}}"
              }
            ],
            "url": {
              "raw": "{{base}}/rest/v1/email_mfa_codes?user_id=eq.{{uidT}}&is_used=eq.false&select=code&order=created_at.desc&limit=1",
              "host": [
                "{{base}}/rest/v1/email_mfa_codes?user_id=eq.{{uidT}}&is_used=eq.false&select=code&order=created_at.desc&limit=1"
              ]
            }
          }
        },
        {
          "name": "Verificar OTP (T)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"OTP aceptado\", () => pm.expect(pm.response.json()).to.eql(true));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{anon_key}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokT}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/rest/v1/rpc/verify_mfa_code",
              "host": [
                "{{base}}/rest/v1/rpc/verify_mfa_code"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"p_code\": \"{{otpT}}\"\n}"
            }
          }
        }
      ]
    },
