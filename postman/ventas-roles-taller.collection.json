    {
      "name": "1 · Datos y garantías por rol",
      "item": [
        {
          "name": "Preparar datos únicos",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const n = Date.now();",
                  "pm.collectionVariables.set(\"serial_t\", \"PT-\" + n);",
                  "pm.collectionVariables.set(\"serial_r\", \"PR-\" + n);",
                  "pm.collectionVariables.set(\"factura_t\", \"FT-\" + n);",
                  "pm.collectionVariables.set(\"cedula\", String(20000000 + Math.floor(Math.random() * 9000000)));",
                  "pm.collectionVariables.set(\"fecha_hoy\", new Date().toISOString().slice(0, 10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"hay producto\", () => pm.expect(pm.response.json().length).to.be.above(0));",
                  "pm.collectionVariables.set(\"producto_id\", pm.response.json()[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "apikey",
                "value": "{{anon_key}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokT}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/rest/v1/productos?select=id&activo=eq.true&limit=1",
              "host": [
                "{{base}}/rest/v1/productos?select=id&activo=eq.true&limit=1"
              ]
            }
          }
        },
        {
          "name": "Recepción guarda cliente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"cliente_id\", pm.response.json());"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{anon_key}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokR}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/rest/v1/rpc/guardar_cliente",
              "host": [
                "{{base}}/rest/v1/rpc/guardar_cliente"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"p_tipo\": \"V\",\n  \"p_documento\": \"{{cedula}}\",\n  \"p_nombre\": \"Cliente Ventas Postman\",\n  \"p_email\": \"ventas@prueba.local\"\n}"
            }
          }
        },
        {
          "name": "Recepción registra garantía (VENTA)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"equipo nuevo\", () => pm.expect(pm.response.json()[0].equipo_id).to.be.a(\"string\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{anon_key}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokR}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/rest/v1/rpc/registrar_garantia",
              "host": [
                "{{base}}/rest/v1/rpc/registrar_garantia"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"p_cliente_id\": \"{{cliente_id}}\",\n  \"p_producto_id\": \"{{producto_id}}\",\n  \"p_serial\": \"{{serial_r}}\",\n  \"p_tipo_soporte\": \"FACTURA\",\n  \"p_numero_soporte\": \"FR-1\",\n  \"p_fecha_emision\": \"{{fecha_hoy}}\",\n  \"p_plazo_dias\": 7\n}"
            }
          }
        },
        {
          "name": "Plazo fuera de 7/15 lo rechaza a quien no es jefe",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"denegado (401, 403)\", () => pm.expect(pm.response.code).to.be.oneOf([401, 403]));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{anon_key}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokR}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/rest/v1/rpc/registrar_garantia",
              "host": [
                "{{base}}/rest/v1/rpc/registrar_garantia"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"p_cliente_id\": \"{{cliente_id}}\",\n  \"p_producto_id\": \"{{producto_id}}\",\n  \"p_serial\": \"{{serial_r}}-X\",\n  \"p_fecha_emision\": \"{{fecha_hoy}}\",\n  \"p_plazo_dias\": 30\n}"
            }
          }
        },
        {
          "name": "Técnico registra garantía de TALLER (sin confirmar)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"equipo_t\", pm.response.json()[0].equipo_id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{anon_key}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokT}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/rest/v1/rpc/registrar_garantia",
              "host": [
                "{{base}}/rest/v1/rpc/registrar_garantia"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"p_cliente_id\": \"{{cliente_id}}\",\n  \"p_producto_id\": \"{{producto_id}}\",\n  \"p_serial\": \"{{serial_t}}\",\n  \"p_tipo_soporte\": \"FACTURA\",\n  \"p_numero_soporte\": \"{{factura_t}}\",\n  \"p_fecha_emision\": \"{{fecha_hoy}}\",\n  \"p_plazo_dias\": 7,\n  \"p_origen\": \"TALLER\"\n}"
            }
          }
        },
        {
          "name": "La garantía de TALLER nace POR_DETERMINAR / PENDIENTE",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const f = pm.response.json()[0];",
                  "pm.test(\"POR_DETERMINAR\", () => pm.expect(f.vigencia).to.eql(\"POR_DETERMINAR\"));",
                  "pm.test(\"compra PENDIENTE\", () => pm.expect(f.estado_compra).to.eql(\"PENDIENTE\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{anon_key}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokT}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/rest/v1/rpc/buscar_equipo",
              "host": [
                "{{base}}/rest/v1/rpc/buscar_equipo"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"p_serial\": \"{{serial_t}}\"\n}"
            }
          }
        }
      ]
    },
